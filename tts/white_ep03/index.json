 },
 "f4": {
  "dur": 3.578,
  "voice": "Achird",
  "text": "助けを呼んだはずの番号は、カラスの巣につながってた。",
  "model": "gemini-2.5-pro-preview-tts"
 },
 "x1": {
  "dur": 1.559,
