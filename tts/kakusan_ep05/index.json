 },
 "b2": {
  "dur": 9.853,
  "voice": "Schedar",
  "text": "これは事件の夜、23時12分に撮られた写真です。後ろに写っているのは、鬼塚レオ。拡散希望。",
  "model": "gemini-3.8-flash-tts"
 },
 "b2b": {
  "dur": 5.027,
  "voice": "Schedar",
  "text": "これ、本物じゃないか。さっきの配信、本当だったんだ。",
