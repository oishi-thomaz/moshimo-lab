 },
 "b4": {
  "dur": 7.136,
  "voice": "Sulafat",
  "text": "ふすまも、ランプも、ちゃぶ台も。私だけが、映っていない。",
  "model": "gemini-3.8-flash-tts"
 },
 "b5": {
  "dur": 2.628,
  "voice": "Sulafat",
  "text": "がめんの、まえに、すわっているはずなのに。",
