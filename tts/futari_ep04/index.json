 },
 "d2": {
  "dur": 0.911,
  "voice": "Orus",
  "text": "黙ってろ。",
  "model": "gemini-3.8-flash-tts"
 },
 "d3": {
  "dur": 4.761,
  "voice": "Sulafat",
  "text": "インターホンの画面で、ハルトが地面に押さえつけられた。",
  "model": "gemini-3.8-flash-tts"
 },
 "d4": {
  "dur": 5.718,
  "voice": "Algenib",
  "text": "警察を待つか？　その前に、息子がどうなるかな。",
