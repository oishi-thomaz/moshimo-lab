 },
 "d5": {
  "dur": 4.262,
  "voice": "Sulafat",
  "text": "ハルトを、守らなきゃ。それだけは、わかる。",
  "model": "gemini-3.8-flash-tts"
 },
 "d6": {
  "dur": 3.462,
  "voice": "Sulafat",
  "text": "私は、玄関の鍵を、開けた。",
  "model": "gemini-3.8-flash-tts"
 },
 "e1": {
  "dur": 5.053,
  "voice": "Sulafat",
  "text": "玄関の開く音。廊下を、誰かが歩いてくる。",
  "model": "gemini-3.8-flash-tts"
 },
 "e2": {
  "dur": 7.009,
  "voice": "Sulafat",
  "text": "足音は、茶の間を通りすぎて、ぶつまの、ふすまの前で止まった。",
  "model": "gemini-3.8-flash-tts"
 },
 "e3": {
  "dur": 1.914,
  "voice": "Orus",
  "text": "…くろださん。誰もいません。",
  "model": "gemini-3.8-flash-tts"
 },
 "e4": {
  "dur": 6.19,
  "voice": "Orus",
  "text": "この家、誰も住んでない。ぶつだんが、あるだけです。",
  "model": "gemini-3.8-flash-tts"
 },
 "e5": {
  "dur": 4.03,
  "voice": "Sulafat",
