 },
 "a10": {
  "dur": 4.331,
  "voice": "Fenrir",
  "text": "読まなかったら、あの友達がどうなるか、分かるよな。",
  "model": "gemini-3.8-flash-tts"
 },
 "a11": {
  "dur": 2.938,
  "voice": "Kore",
  "text": "倉庫の隅で、けんとが目をそらした。",
  "model": "gemini-3.8-flash-tts"
 },
 "b1": {
  "dur": 2.027,
  "voice": "Autonoe",
  "text": "アカリ、戻ってこない…",
