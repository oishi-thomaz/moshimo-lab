 },
 "b3": {
  "dur": 4.011,
  "voice": "Autonoe",
  "text": "アカリの写真は、いつも私との共有アルバムに入る。",
  "model": "gemini-3.8-flash-tts"
 },
 "b4": {
  "dur": 3.347,
  "voice": "Autonoe",
  "text": "あった。にじゅうさんじ、じゅうにふんの、あの写真。",
