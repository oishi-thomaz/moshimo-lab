 },
 "a2": {
  "dur": 4.531,
  "voice": "Kore",
  "text": "配信が止まると、鬼塚の顔から笑顔が消えた。",
  "model": "gemini-3.8-flash-tts"
 },
 "a3": {
  "dur": 3.453,
  "voice": "Fenrir",
