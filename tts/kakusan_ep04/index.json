 },
 "b5": {
  "dur": 6.562,
  "voice": "Schedar",
  "text": "健人です。港の第3倉庫。アカリさんは、ここにいる。警察を呼んでくれ。",
  "model": "gemini-3.8-flash-tts"
 },
 "b6": {
  "dur": 4.222,
  "voice": "Autonoe",
  "text": "もしもし、警察ですか！通り魔の本当の犯人が、分かりました！",
  "model": "gemini-3.8-flash-tts"
 },
 "c1": {
  "dur": 5.846,
  "voice": "Fenrir",
  "text": "みなさん、お待たせしましたー！通り魔の女が、自白しまーす！",
  "model": "gemini-3.8-flash-tts"
 },
 "c2": {
  "dur": 6.15,
  "voice": "Kore",
  "text": "カメラを持っているのは、鬼塚。画面に映っているのは、私だけ。",
  "model": "gemini-3.8-flash-tts"
 },
 "c3": {
  "dur": 7.637,
  "voice": "Kore",
  "text": "どうじしちょう、にじゅうまんにん。みんなが、私の、じはくを待っている。",
  "model": "gemini-3.8-flash-tts"
 },
 "c4": {
  "dur": 3.951,
  "voice": "Kore",
  "text": "私は…あの夜、駅前で…",
  "model": "gemini-3.8-flash-tts"
 },
 "c5": {
  "dur": 6.656,
  "voice": "Kore",
  "text": "ここで読んだら、本当に、おわる。でも今なら、にじゅうまんにんに届く。",
  "model": "gemini-3.8-flash-tts"
 },
 "c5b": {
  "dur": 3.289,
  "voice": "Kore",
  "text": "カメラの後ろで、けんとが小さくうなずいた。",
  "model": "gemini-3.8-flash-tts"
 },
 "c6": {
  "dur": 3.525,
  "voice": "Kore",
  "text": "犯人は…今カメラを持っている、この人です。",
  "model": "gemini-3.8-flash-tts"
 },
 "c7": {
  "dur": 3.795,
  "voice": "Kore",
  "text": "おにづかレオ。あの夜、私はこの人を見ました。",
  "model": "gemini-3.8-flash-tts"
 },
 "c8": {
  "dur": 2.475,
  "voice": "Kore",
  "text": "鬼塚が、刃物を取り出した。",
  "model": "gemini-3.8-flash-tts"
 },
 "x1": {
  "dur": 3.09,
  "voice": "Schedar",
  "text": "次回、最終話。拡散希望。",
  "model": "gemini-3.8-flash-tts"
 }
}