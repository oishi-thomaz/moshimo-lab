 },
 "d5": {
  "dur": 4.962,
  "voice": "Rasalgethi",
  "text": "警察にかけても、無駄ですよ。先週も、そうでしたから。",
  "model": "gemini-3.8-flash-tts"
 },
 "e1": {
  "dur": 5.135,
  "voice": "Orus",
  "text": "開けていただけないなら…息子さん本人に、頼んでもらいましょう。",
  "model": "gemini-3.8-flash-tts"
 },
 "e2": {
  "dur": 4.36,
  "voice": "Sulafat",
  "text": "画面の端から、フードをかぶった若い男が、引き出された。",
  "model": "gemini-3.8-flash-tts"
 },
 "e3": {
  "dur": 5.067,
  "voice": "Sulafat",
