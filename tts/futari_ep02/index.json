  "model": "gemini-3.8-flash-tts"
 },
 "e4": {
  "dur": 3.261,
  "voice": "Iapetus",
  "text": "かあさん…俺だよ。開けて。",
  "model": "gemini-3.8-flash-tts"
 },
 "e5": {
  "dur": 3.248,
