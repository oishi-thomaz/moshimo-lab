  "dur": 5.289,
  "voice": "Achernar",
  "text": "だから箱で、写真を送ったの。あなたに、自分で見つけてほしくて。",
  "model": "gemini-3.8-flash-tts"
 },
 "b1": {
  "dur": 5.263,
  "voice": "Sadaltager",
  "text": "前の人も、そうやって閉じこもってましたよ。",
  "model": "gemini-3.8-flash-tts"
 },
 "b2": {
  "dur": 3.025,
  "voice": "Despina",
  "text": "すき間から、チェーンに工具がかかる。",
  "model": "gemini-3.8-flash-tts"
 },
 "b3": {
  "dur": 2.082,
  "voice": "Despina",
  "text": "逃げる場所は、どこにもない。",
  "model": "gemini-3.8-flash-tts"
 },
 "c1": {
  "dur": 2.065,
  "voice": "Puck",
  "text": "とがわさん。お届け物です。",
