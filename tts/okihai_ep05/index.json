 },
 "c3": {
  "dur": 7.601,
  "voice": "Puck",
  "text": "まいばん、さんじじゅうにふんの写真と、いちねんまえの動画。同じものを、警察にも届けました。",
  "model": "gemini-3.8-flash-tts"
 },
 "c3b": {
  "dur": 6.088,
  "voice": "Despina",
  "text": "遠くから、サイレンが近づいてくる。とがわさんの手から、工具が落ちた。",
  "model": "gemini-3.8-flash-tts"
 },
 "c4": {
  "dur": 1.428,
  "voice": "Sadaltager",
  "text": "…どうして、おまえが。",
  "model": "gemini-3.8-flash-tts"
 },
 "c5": {
  "dur": 2.084,
  "voice": "Puck",
