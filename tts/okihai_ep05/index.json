{
 "k1": {
  "dur": 2.132,
  "voice": "Despina",
  "text": "ドアが、外から開いた。",
  "model": "gemini-3.8-flash-tts"
 },
 "k2": {
  "dur": 2.601,
  "voice": "Despina",
  "text": "とっさにかけたチェーンが、ドアを止めた。",
  "model": "gemini-3.8-flash-tts"
 },
 "k3": {
  "dur": 3.841,
  "voice": "Sadaltager",
  "text": "あいざわさん。チェーン、外してください。",
  "model": "gemini-3.8-flash-tts"
 },
 "a1": {
  "dur": 3.139,
  "voice": "Achernar",
  "text": "そのスマホの中に、いちねんまえの動画が残ってる。",
  "model": "gemini-3.8-flash-tts"
 },
 "a2": {
  "dur": 3.08,
  "voice": "Despina",
