 },
 "d3": {
  "dur": 4.606,
  "voice": "Achernar",
  "text": "このいちねん、ずっと、誰かに見つけてほしかった。",
  "model": "gemini-3.8-flash-tts"
 },
 "d4": {
  "dur": 4.164,
  "voice": "Despina",
  "text": "見つけたのは、私じゃない。あなたの箱です。",
  "model": "gemini-3.8-flash-tts"
 },
 "d5": {
  "dur": 3.897,
  "voice": "Puck",
  "text": "相沢さん。今夜は、ちゃんと眠れますよ。",
  "model": "gemini-3.8-flash-tts"
 },
 "e1": {
  "dur": 4.075,
  "voice": "Despina",
  "text": "いっかげつご。私は、新しい部屋に引っ越した。",
  "model": "gemini-3.8-flash-tts"
 },
 "e2": {
  "dur": 2.105,
  "voice": "Despina",
  "text": "朝、ドアを開けると——",
  "model": "gemini-3.8-flash-tts"
 },
 "e3": {
  "dur": 2.969,
  "voice": "Despina",
  "text": "玄関の前に、段ボールが、ひとつ。",
  "model": "gemini-3.8-flash-tts"
 },
 "e4": {
  "dur": 6.483,
  "voice": "Despina",
  "text": "届け先は、あいざわみおさま。でも、その字に、見覚えはなかった。",
  "model": "gemini-3.8-flash-tts"
 },
 "e5": {
  "dur": 2.996,
  "voice": "Despina",
  "text": "さしだしにんの、らんには、こう書いてあった。",
  "model": "gemini-3.8-flash-tts"
 },
 "e6": {
  "dur": 2.618,
  "voice": "Despina",
  "text": "この部屋の、前の住人より。",
  "model": "gemini-3.8-flash-tts"
 },
 "x1": {
  "dur": 1.695,
  "voice": "Schedar",
  "text": "おきはい。かん。",
  "model": "gemini-3.8-flash-tts"
 }
}