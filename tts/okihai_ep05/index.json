  "model": "gemini-3.8-flash-tts"
 },
 "c6": {
  "dur": 7.438,
  "voice": "Despina",
  "text": "待ち受けの写真の、若い男。ケンさんは、サキさんの弟だった。",
  "model": "gemini-3.8-flash-tts"
 },
 "d1": {
  "dur": 5.674,
  "voice": "Despina",
  "text": "夜が明けた。廊下に、はじめて見る人が立っていた。",
  "model": "gemini-3.8-flash-tts"
 },
 "d2": {
  "dur": 2.519,
  "voice": "Achernar",
