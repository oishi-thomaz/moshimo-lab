{
 "k2": {
  "dur": 4.127,
  "voice": "Sulafat",
  "text": "かいちゅうでんとうの光が、ぶつだんの写真を照らした。",
  "model": "gemini-3.8-flash-tts"
 },
 "k3": {
  "dur": 3.236,
  "voice": "Sulafat",
  "text": "写っていたのは、私だった。",
  "model": "gemini-3.8-flash-tts"
 },
 "a1": {
  "dur": 2.937,
  "voice": "Orus",
  "text": "うわっ！スピーカーが、しゃべった！",
  "model": "gemini-3.8-flash-tts"
 },
 "a2": {
  "dur": 3.41,
  "voice": "Iapetus",
  "text": "母さん。…もう、隠せないね。",
  "model": "gemini-3.8-flash-tts"
 },
 "a3": {
  "dur": 5.22,
  "voice": "Iapetus",
  "text": "かあさんは、にねんまえの、じゅうがつに、病気で死んだんだ。",
  "model": "gemini-3.8-flash-tts"
 },
 "a4": {
  "dur": 4.557,
  "voice": "Sulafat",
  "text": "死んだ？　じゃあ、ここにいる私は——",
