 },
 "a4": {
  "dur": 4.542,
  "voice": "Aoede",
  "text": "ごねんまえ、ちちのスマホに、女からのメッセージを見たから。",
  "model": "gemini-3.8-flash-tts"
 },
 "a5": {
  "dur": 3.269,
  "voice": "Aoede",
  "text": "問いつめても、父は何も言い訳しなかった。",
  "model": "gemini-3.8-flash-tts"
 },
 "a6": {
  "dur": 1.092,
  "voice": "Aoede",
  "text": "…あの女だ。",
  "model": "gemini-3.8-flash-tts"
 },
 "b1": {
  "dur": 2.677,
  "voice": "Aoede",
  "text": "ちちの、たんじょうびを入れた。",
