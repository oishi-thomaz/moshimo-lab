{
 "k1": {
  "dur": 1.043,
  "voice": "Erinome",
  "text": "おはよう、あなた。",
  "model": "gemini-3.8-flash-tts"
 },
 "k2": {
  "dur": 6.839,
  "voice": "Aoede",
  "text": "ちちの、そうしきの、次の朝。死んだ父のスマホに、女から届いた。",
  "model": "gemini-3.8-flash-tts"
 },
 "k3": {
  "dur": 3.113,
  "voice": "Erinome",
  "text": "きょうは寒いから、ちゃんと、うわぎを着てね。",
  "model": "gemini-3.8-flash-tts"
 },
 "a1": {
  "dur": 2.497,
  "voice": "Aoede",
  "text": "いのうえナツキ、さんじゅうよんさい。",
  "model": "gemini-3.8-flash-tts"
 },
 "a2": {
  "dur": 6.003,
  "voice": "Aoede",
  "text": "ちちの、いひんを片づけに、ひとりで実家の、だんちに戻ってきた。",
