# タイトル当てクイズの投稿サーバーの設定（/etc/quiz.env。chmod 600）。もしもラボ・いつわ劇場とは別に動く
PORT=8789
PREFIX=/quiz
BRAND=タイトル当てクイズ
# 外から見えるURL（nginx の location /quiz/ の先）。末尾スラッシュなし
BASE_URL=https://あなたのドメイン/quiz
DATA_DIR=/var/lib/quiz
# GitHub Actions と共有する合言葉（GitHub の Secrets の QUIZ_SECRET にも同じ値を入れる）
HOOK_SECRET=
# LINE Developers の Messaging API チャネル（タイトル当てクイズ通知）
LINE_CHANNEL_SECRET=
LINE_CHANNEL_TOKEN=
# 空でOK。公式アカウントを友だち追加して何か送ると、自動でゆうとのIDが登録される
LINE_OWNER_USER_ID=
# Instagram（title_ate_quiz の長期トークンとユーザーID）
IG_USER_ID=
IG_TOKEN=
# 投稿時刻（日本時間）。立ち上げの1か月は1日5本。あとで LINE の「投稿時間 12:00,20:00」で変えられる
POST_TIMES=12:00,15:00,18:00,20:00,22:00
# 承認待ちが残ってたら再通知する時刻（日本時間）
REMIND_TIMES=10:30,14:30,19:30
# 動画が届いたらすぐ承認カードを送る（朝の書き出しが終わった順に届く）
APPROVAL_NOW=1
# TikTok は Mac の Chrome で予約投稿する（このサーバーからは送らない）。解析で使うユーザー名
TT_USERNAME=title_ate_quiz
