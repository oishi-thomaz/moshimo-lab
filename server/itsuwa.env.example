# いつわ劇場の投稿サーバーの設定（/etc/itsuwa.env。chmod 600）。もしもラボとは別に動く
PORT=8788
PREFIX=/itsuwa
BRAND=いつわ劇場
# 外から見えるURL（nginx の location /itsuwa/ の先）。末尾スラッシュなし
BASE_URL=https://あなたのドメイン/itsuwa
DATA_DIR=/var/lib/itsuwa
# GitHub Actions と共有する合言葉（GitHub の Secrets の ITSUWA_SECRET にも同じ値を入れる）
HOOK_SECRET=
# LINE Developers の Messaging API チャネル（いつわ劇場通知）
LINE_CHANNEL_SECRET=
LINE_CHANNEL_TOKEN=
# 空でOK。公式アカウントを友だち追加して何か送ると、自動でゆうとのIDが登録される
LINE_OWNER_USER_ID=
# Instagram（itsuwa_drama の長期トークンとユーザーID）
IG_USER_ID=
IG_TOKEN=
# 投稿時刻（日本時間）。1日1話
POST_TIMES=20:00
# 動画が届いたらすぐ承認カードを送る
APPROVAL_NOW=1
# インスタに投稿するのと同時に TikTok の下書きへ送る
TT_UPLOAD=1
TT_USERNAME=itsuwa_drama
