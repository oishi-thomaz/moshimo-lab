# ニュースアカウントの投稿サーバーの設定（/etc/news.env。chmod 600）。もしもラボ・クイズ・いつわ劇場とは別に動く
PORT=8791
PREFIX=/news
# アカウント名（ログと知らせの文に出す）
BRAND=なにこれ通信
# 外から見えるURL（nginx の location /news/ の先）。末尾スラッシュなし
BASE_URL=https://あなたのドメイン/news
DATA_DIR=/var/lib/news
# GitHub Actions と共有する合言葉（GitHub の Secrets の NEWS_SECRET にも同じ値を入れる）
HOOK_SECRET=
# Instagram（新しいニュースアカウントの長期トークンとユーザーID）
IG_USER_ID=
IG_TOKEN=
# 投稿時刻（日本時間）。立ち上げは1日4本から。慣れたら 6本→8本と増やす（docs/NEWS.md の 立ち上げの増やし方）
POST_TIMES=07:30,12:10,18:30,21:30
# 届いてからこの時間を過ぎたネタは出さない
EXPIRE_H=72
# 失敗・在庫切れ・トークン更新の失敗だけ SNS司令室の LINE に知らせる（install-news.sh が /etc/sns.env からコピーする）
ALERT_LINE_TOKEN=
